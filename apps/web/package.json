{
  "name": "@toonexpo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ToonExpo Next.js frontend",
  "scripts": {
    "copy:maplibre-worker": "node scripts/copy-maplibre-worker.mjs",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "predev": "pnpm run copy:maplibre-worker",
    "prebuild": "pnpm run copy:maplibre-worker",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",

    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:playwright": "playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-query": "^5.102.2",
    "@toonexpo/contracts": "workspace:*",
    "@toonexpo/shared": "workspace:*",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "clsx": "2.1.1",
    "lucide-react": "0.525.0",
    "maplibre-gl": "^6.5.0",
    "next": "16.3.2",
    "next-intl": "4.13.7",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@toonexpo/config": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
