/// Partner profile type (display category on public partner pages).
enum PartnerCompanyType {
  builder
  bank
  it_company
  sponsor
  supplier
  insurance
  legal
  design_furniture
  service_company
  other
}

enum PartnerCompanyStatus {
  active
  inactive
}

/// Public partner profile linked 1:1 to a Company (partner / bank / service).
model PartnerCompany {
  id                String               @id @default(cuid())
  companyId         String               @unique @map("company_id")
  type              PartnerCompanyType
  name              String
  slug              String               @unique
  logoMediaId       String?              @map("logo_media_id")
  coverMediaId      String?              @map("cover_media_id")
  shortDescription  String?              @map("short_description")
  fullDescription   String?              @map("full_description")
  contacts          Json?
  website           String?
  socialLinks       Json?                @map("social_links")
  status            PartnerCompanyStatus @default(active)
  publicationStatus PublicationStatus    @default(draft) @map("publication_status")
  featured          Boolean              @default(false)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logoMedia  MediaAsset?    @relation("PartnerLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  coverMedia MediaAsset?    @relation("PartnerCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  offers                       PartnerOffer[]
  bankOffers                   BankOffer[]
  bankPartnerOfferTemplates    BankPartnerOfferTemplate[]
  projectBankPartnerOffers     ProjectBankPartnerOffer[]

  @@index([slug])
  @@index([companyId])
  @@index([type, publicationStatus])
  @@map("partner_companies")
}

/// Generic partner offer/service (non-bank; BankOffer is a separate Mortgage entity).
model PartnerOffer {
  id                String            @id @default(cuid())
  partnerCompanyId  String            @map("partner_company_id")
  title             String
  description       String?
  type              String?
  publicationStatus PublicationStatus @default(draft) @map("publication_status")
  sortOrder         Int               @default(0) @map("sort_order")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  partnerCompany PartnerCompany @relation(fields: [partnerCompanyId], references: [id], onDelete: Cascade)

  @@index([partnerCompanyId])
  @@index([publicationStatus])
  @@map("partner_offers")
}

/// Mortgage offer terms for bank partners (Mortgage module).
model BankOffer {
  id                    String            @id @default(cuid())
  partnerCompanyId      String            @map("partner_company_id")
  title                 String
  shortDescription      String?           @map("short_description")
  /// Annual interest rate in percent (e.g. 12.5).
  rate                  Decimal           @db.Decimal(5, 2)
  apr                   Decimal?          @db.Decimal(5, 2)
  minDownPaymentPercent Decimal           @map("min_down_payment_percent") @db.Decimal(5, 2)
  termOptionsYears      Int[]             @map("term_options_years")
  fees                  String?
  calculationNotes      String?           @map("calculation_notes")
  featured              Boolean           @default(false)
  sortOrder             Int               @default(0) @map("sort_order")
  publicationStatus     PublicationStatus @default(draft) @map("publication_status")
  createdByUserId       String            @map("created_by_user_id")
  updatedByUserId       String?           @map("updated_by_user_id")
  publishedAt           DateTime?         @map("published_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  partnerCompany PartnerCompany @relation(fields: [partnerCompanyId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("BankOfferCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy      User?          @relation("BankOfferUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([partnerCompanyId])
  @@index([publicationStatus])
  @@map("bank_offers")
}

/// Admin-managed reusable finance offer template (project Finance fields).
/// Not tied to a bank — bank text lives in finance fields and is edited per project after Import.
model BankPartnerOfferTemplate {
  id                String            @id @default(cuid())
  partnerCompanyId  String?           @map("partner_company_id")
  name              String
  /// Localized finance fields matching project catalog Finance keys.
  /// Shape: { [key]: { hy, ru, en } }
  fields            Json
  publicationStatus PublicationStatus @default(draft) @map("publication_status")
  sortOrder         Int               @default(0) @map("sort_order")
  createdByUserId   String            @map("created_by_user_id")
  updatedByUserId   String?           @map("updated_by_user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  partnerCompany PartnerCompany?           @relation(fields: [partnerCompanyId], references: [id], onDelete: SetNull)
  createdBy      User                      @relation("BankPartnerOfferTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy      User?                     @relation("BankPartnerOfferTemplateUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  projectOffers  ProjectBankPartnerOffer[]

  @@index([partnerCompanyId])
  @@index([publicationStatus])
  @@index([sortOrder])
  @@map("bank_partner_offer_templates")
}

/// Project-scoped copy of a bank partner offer template (editable independently).
model ProjectBankPartnerOffer {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  templateId       String?  @map("template_id")
  /// Optional link to PartnerCompany; bank name may live in finance fields only.
  partnerCompanyId String?  @map("partner_company_id")
  name             String
  /// Copied localized finance fields; project edits do not mutate the template.
  fields           Json
  sortOrder        Int      @default(0) @map("sort_order")
  createdByUserId  String   @map("created_by_user_id")
  updatedByUserId  String?  @map("updated_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template       BankPartnerOfferTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  partnerCompany PartnerCompany?           @relation(fields: [partnerCompanyId], references: [id], onDelete: SetNull)
  createdBy      User                      @relation("ProjectBankPartnerOfferCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy      User?                     @relation("ProjectBankPartnerOfferUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, templateId])
  @@index([projectId])
  @@index([partnerCompanyId])
  @@index([templateId])
  @@map("project_bank_partner_offers")
}

enum ServiceProviderType {
  company
  person
  team
  other
}

model ServiceProviderCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  logoMediaId String?  @map("logo_media_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  logoMedia           MediaAsset?                   @relation("ServiceProviderCategoryLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  providers           ServiceProviderCategoryLink[]
  readinessCategories ReadinessCategory[]
  readinessCriteria   ReadinessCriterion[]

  @@index([active])
  @@index([sortOrder])
  @@index([logoMediaId])
  @@map("service_provider_categories")
}

model ServiceProvider {
  id                String               @id @default(cuid())
  name              String
  providerType      ServiceProviderType  @map("provider_type")
  description       String?
  services          String?
  phone             String?
  email             String?
  website           String?
  socialLinks       Json?                @map("social_links")
  internalNotes     String?              @map("internal_notes")
  active            Boolean              @default(true)
  publicationStatus PublicationStatus?   @map("publication_status")
  createdByUserId   String               @map("created_by_user_id")
  updatedByUserId   String?              @map("updated_by_user_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  categories ServiceProviderCategoryLink[]
  createdBy  User                          @relation("ServiceProviderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy  User?                         @relation("ServiceProviderUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([providerType])
  @@index([publicationStatus])
  @@map("service_providers")
}

model ServiceProviderCategoryLink {
  serviceProviderId         String @map("service_provider_id")
  serviceProviderCategoryId String @map("service_provider_category_id")

  serviceProvider ServiceProvider         @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  category        ServiceProviderCategory @relation(fields: [serviceProviderCategoryId], references: [id], onDelete: Cascade)

  @@id([serviceProviderId, serviceProviderCategoryId])
  @@index([serviceProviderCategoryId])
  @@map("service_provider_category_links")
}
