/// Typed value for PlatformSetting.value (stored as string; parsed by key).
enum PlatformSettingValueType {
  string
  json
  boolean
  number
}

/// Platform-wide key/value settings (homepage CMS keys, feature flags, etc.).
model PlatformSetting {
  id              String                   @id @default(cuid())
  key             String                   @unique
  value           String
  valueType       PlatformSettingValueType @default(string) @map("value_type")
  description     String?
  updatedByUserId String?                  @map("updated_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  updatedByUser User? @relation("PlatformSettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("platform_settings")
}
